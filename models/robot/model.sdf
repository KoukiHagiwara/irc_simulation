<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="my_robot">
    <static>false</static>
    <plugin filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <plugin
        filename="libignition-gazebo-diff-drive-system.so"
        name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>odometry</odom_topic> 
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
    </plugin> 
    
    <plugin filename="libignition-gazebo-triggered-publisher-system.so"
            name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">16777235</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/cmd_vel">
            linear: {x: 0.2}, angular: {z: 0.0}
        </output>
    </plugin>
    <plugin filename="libignition-gazebo-triggered-publisher-system.so"
            name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">16777237</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/cmd_vel">
            linear: {x: -0.2}, angular: {z: 0.0}
        </output>
    </plugin>

    <plugin filename="libignition-gazebo-triggered-publisher-system.so"
            name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">16777236</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/cmd_vel">
            linear: {x: 0.0}, angular: {z: -0.5}
        </output>
    </plugin>
    <plugin filename="libignition-gazebo-triggered-publisher-system.so"
            name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">16777234</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/cmd_vel">
            linear: {x: 0.0}, angular: {z: 0.5}
        </output>
    </plugin>

    <link name="base_link">
      <pose>0.35 0 0 0 0 0</pose>
      <inertial>
        <mass>5.1</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://robot/robo.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://robot/robo.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name='left_wheel'>
        <pose relative_to="base_link">-0.18 0 -0.027 0 3.14 0</pose>
        <inertial>
            <mass>1</mass>
            <inertia>
                <ixx>0.043333</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.043333</iyy>
                <iyz>0</iyz>
                <izz>0.08</izz>
            </inertia>
        </inertial>

        <visual name='visual'>
            <geometry>
                <mesh>
                  <scale>1 1 1</scale>
                  <uri>model://robot/wheel.dae</uri>
                </mesh>
            </geometry>
            <material>
                <ambient>1.0 0.0 0.0 1</ambient>
                <diffuse>1.0 0.0 0.0 1</diffuse>
                <specular>1.0 0.0 0.0 1</specular>
            </material>
        </visual>
        <collision name='collision'>
            <geometry>
                <mesh>
                    <scale>1 1 1</scale>
                    <uri>model://robot/wheel.stl</uri>
                </mesh>
            </geometry>
        </collision>
    </link>
    <joint name='left_wheel_joint' type='revolute'>
        <pose relative_to='left_wheel'/>
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
            <xyz expressed_in='__model__'>-1 0 0</xyz>
            <limit>
                <lower>-1.79769e+308</lower>    <upper>1.79769e+308</upper>     </limit>
        </axis>
    </joint>

    <link name='right_wheel'>
        <pose relative_to="base_link">0.18 0 -0.027 0 0 0</pose> <inertial>
            <mass>1</mass>
            <inertia>
                <ixx>0.043333</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.043333</iyy>
                <iyz>0</iyz>
                <izz>0.08</izz>
            </inertia>
        </inertial>
        <visual name='visual'>
            <geometry>
                <mesh>
                    <scale>1 1 1</scale>
                    <uri>model://robot/wheel.dae</uri>
                </mesh>
            </geometry>
            <material>
                <ambient>1.0 0.0 0.0 1</ambient>
                <diffuse>1.0 0.0 0.0 1</diffuse>
                <specular>1.0 0.0 0.0 1</specular>
            </material>
        </visual>
        <collision name='collision'>
            <geometry>
                <mesh>
                    <scale>1 1 1</scale>
                    <uri>model://robot/wheel.stl</uri>
                </mesh>
            </geometry>
        </collision>
    </link>
    <joint name='right_wheel_joint' type='revolute'>
        <pose relative_to='right_wheel'/>
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
            <xyz expressed_in='__model__'>-1 0 0</xyz>
            <limit>
                <lower>-1.79769e+308</lower>    <upper>1.79769e+308</upper>     </limit>
        </axis>
    </joint>


    <link name="camera_link">
      <pose relative_to='__model__'>0.35 0.17 0.325 0 0.9 1.6</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box><size>0.063 0.07 0.03</size></box>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>
          <ambient>0 0 1 1</ambient>
        </material>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <camera>
          <camera_info_topic>camera_info</camera_info_topic>        
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <topic>/camera_sensor</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize> 
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="line_left4_link">
      <pose relative_to="base_link">-0.063 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_left4" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/left4</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_left4_joint" type="fixed"><parent>base_link</parent><child>line_left4_link</child></joint>

    <link name="line_left3_link">
      <pose relative_to="base_link">-0.045 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_left3" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/left3</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_left3_joint" type="fixed"><parent>base_link</parent><child>line_left3_link</child></joint>

    <link name="line_left2_link">
      <pose relative_to="base_link">-0.027 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_left2" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/left2</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_left2_joint" type="fixed"><parent>base_link</parent><child>line_left2_link</child></joint>

    <link name="line_left1_link">
      <pose relative_to="base_link">-0.009 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_left1" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/left1</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_left1_joint" type="fixed"><parent>base_link</parent><child>line_left1_link</child></joint>


    <link name="line_right1_link">
      <pose relative_to="base_link">0.009 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_right1" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/right1</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_right1_joint" type="fixed"><parent>base_link</parent><child>line_right1_link</child></joint>

    <link name="line_right2_link">
      <pose relative_to="base_link">0.027 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_right2" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/right2</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_right2_joint" type="fixed"><parent>base_link</parent><child>line_right2_link</child></joint>

    <link name="line_right3_link">
      <pose relative_to="base_link">0.045 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_right3" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/right3</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_right3_joint" type="fixed"><parent>base_link</parent><child>line_right3_link</child></joint>

    <link name="line_right4_link">
      <pose relative_to="base_link">0.063 0.2 -0.061 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.015 0.022 0.01</size></box></geometry>
        <material><diffuse>0.0 1.0 1.0 1.0</diffuse><ambient>0.0 1.0 1.0 1.0</ambient></material>
      </visual>
      <sensor name="line_right4" type="camera">
        <pose>0 0 0 0 1.57 0</pose>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image><width>2</width><height>2</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>0.2</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/line/right4</topic>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="line_right4_joint" type="fixed"><parent>base_link</parent><child>line_right4_link</child></joint>

  </model>
</sdf>